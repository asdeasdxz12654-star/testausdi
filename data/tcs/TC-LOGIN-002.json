{
  "id": "TC-LOGIN-002",
  "title": "잘못된 비밀번호 입력 시 에러 메시지 노출",
  "priority": "P1",
  "automation": "적합",
  "tags": ["smoke", "regression"],
  "reqIds": ["LGN-03"],
  "platforms": ["pc", "mw", "android", "ios"],
  "precondition": "로그아웃 상태, 테스트 계정 보유",
  "steps": [
    { "action": "open", "target": "screen.login" },
    { "action": "input", "target": "login.id", "value": "{{account.id}}" },
    { "action": "input", "target": "login.pw", "value": "wrong_pw_01" },
    { "action": "hideKeyboard" },
    { "action": "tap", "target": "login.submit" },
    { "action": "assertText", "target": "login.error", "value": "Epic sadface: Username and password do not match any user in this service" }
  ]
}
