{
  "id": "TC-LOGIN-005",
  "title": "로그인 입력 검증 메시지",
  "priority": "P2",
  "automation": "적합",
  "tags": [
    "regression"
  ],
  "reqIds": [
    "LGN-03",
    "LGN-04"
  ],
  "platforms": [
    "pc",
    "mw",
    "android",
    "ios"
  ],
  "precondition": "로그아웃 상태. 행 데이터는 일부러 틀린 입력값이며 실제 비밀번호는 넣지 않습니다",
  "manualMinutes": 3,
  "steps": [
    {
      "action": "open",
      "target": "screen.login"
    },
    {
      "action": "input",
      "target": "login.id",
      "value": "{{row.id}}"
    },
    {
      "action": "input",
      "target": "login.pw",
      "value": "{{row.inputPw}}"
    },
    {
      "action": "hideKeyboard"
    },
    {
      "action": "tap",
      "target": "login.submit"
    },
    {
      "action": "assertText",
      "target": "login.error",
      "value": "{{row.error}}"
    }
  ],
  "dataSets": [
    {
      "name": "아이디 비움",
      "values": {
        "id": "",
        "inputPw": "any_pw",
        "error": "Epic sadface: Username is required"
      }
    },
    {
      "name": "비밀번호 비움",
      "values": {
        "id": "standard_user",
        "inputPw": "",
        "error": "Epic sadface: Password is required"
      }
    },
    {
      "name": "틀린 비밀번호",
      "values": {
        "id": "standard_user",
        "inputPw": "wrong_pw_02",
        "error": "Epic sadface: Username and password do not match any user in this service"
      }
    }
  ]
}
