{
  "id": "TC-LOGIN-003",
  "title": "잠긴 계정으로 로그인 시 잠금 안내 노출",
  "priority": "P2",
  "automation": "적합",
  "tags": ["regression"],
  "reqIds": ["LGN-05"],
  "platforms": ["pc", "mw"],
  "precondition": "잠금 처리된 테스트 계정 보유",
  "steps": [
    { "action": "open", "target": "screen.login" },
    { "action": "input", "target": "login.id", "value": "{{account.locked}}" },
    { "action": "input", "target": "login.pw", "value": "{{account.password}}" },
    { "action": "tap", "target": "login.submit" },
    { "action": "assertText", "target": "login.error", "value": "Epic sadface: Sorry, this user has been locked out." }
  ]
}
